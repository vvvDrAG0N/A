{
  "name": "Novel Fire",
  "version": "1.0",
  "baseUrl": "https://novelfire.net/",
  "searchUrl": "https://novelfire.net/search?keyword={{key}}&page={{page}}",
  "search": {
    "list": ".novel-list.chapters .novel-item",
    "name": "a@title",
    "author": "",
    "cover": ".novel-cover img@src",
    "detail": "a@href"
  },
  "detail": {
    "name": ".novel-title",
    "cover": ".cover img@data-src || .cover img@src",
    "summary": ".summary .content",
    "status": ".header-stats .ongoing:contains(ongoing) || .header-stats .completed:contains(completed)",
    "author": ".author .property-item span",
    "genre": ".categories .property-item",
    "chapters": {
      "list": "#chapterList li a",
      "name": "a@title",
      "url": "a@href"
    }
  },
  "chapter": {
    "content": "#content",
    "replace": [
      { "pattern": "&nbsp;", "replacement": " " }
    ],
    "filter": [
      "script",
      "style",
      "div.ad",
      "nf\\w+"
    ]
  },
  "discover": {
    "popular": "https://novelfire.net/search-adv?ctgcon=and&totalchapter=0&ratcon=min&rating=0&status=-1&sort=rank-top&page={{page}}",
    "latest": "https://novelfire.net/search-adv?ctgcon=and&totalchapter=0&ratcon=min&rating=0&status=-1&sort=date&page={{page}}"
  }
}
